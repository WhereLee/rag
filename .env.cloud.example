# ============================================================
# RAG 项目 - 云服务器环境变量模板（4C4G3M）
# 部署时复制为 .env 并填入实际值：cp .env.cloud.example .env
# ============================================================

# --- MiMo LLM API ---
MIMO_API_KEY=sk-your-api-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# --- PostgreSQL ---
# 云服务器建议使用强密码，并限制 PostgreSQL 仅监听 localhost
PG_DSN=postgresql://postgres:STRONG_PASSWORD_HERE@localhost:5432/rag_kb

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- 安全 ---
# 必须设置：Python 服务与 Java 网关之间的鉴权密钥
INTERNAL_API_KEY=your-random-secret-key-at-least-32-chars
# 必须设置：JWT 签名密钥（Java 网关使用）
GATEWAY_JWT_SECRET=your-random-jwt-secret-at-least-32-chars
GATEWAY_INTERNAL_API_KEY=your-random-secret-key-at-least-32-chars

# --- 推理参数（cloud 4C4G 优化）---
# ONNX 线程数：4 核服务器建议 2，留 2 核给 Java/系统
ONNX_THREADS=2
# Embedding 批处理大小：4G 内存建议 16（master=32）
EMBED_BATCH_SIZE=16
# Reranker 模型：bge-reranker-base（~100MB，纯中文场景够用）
RERANK_MODEL_DIR=bge-reranker-base-onnx-int8

# --- 连接池（4C4G 缩减）---
PG_POOL_MIN=2
PG_POOL_MAX=10

# --- 生产环境标记 ---
SPRING_PROFILES_ACTIVE=prod
